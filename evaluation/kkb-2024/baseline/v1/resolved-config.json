{
  "algorithm": {
    "tuning_status": "poc_initial_not_optimized",
    "version": "v1"
  },
  "boundary_embedding": {
    "cache_dir": ".cache\\boundary-embeddings",
    "device": "auto",
    "max_input_tokens_override": null,
    "model": "intfloat/multilingual-e5-base",
    "normalize_embeddings": true,
    "overlength_strategy": "sentence_fragment_token_weighted_pooling",
    "prefix": "query: ",
    "prefix_policy": "symmetric_query",
    "revision": null
  },
  "selection": {
    "semantic_weight": 0.8,
    "size_weight": 0.2
  },
  "semantic": {
    "fixed_threshold": 0.2
  },
  "token_counter": {
    "cap_semantics": "configured_poc_counter_only",
    "encoding": "cl100k_base",
    "provider": "tiktoken"
  },
  "tokens": {
    "hard_max_tokens": 1126,
    "min_tokens": 160,
    "soft_max_tokens": 900,
    "target_tokens": 700
  }
}
